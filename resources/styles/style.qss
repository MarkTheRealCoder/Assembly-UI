variables {
    
    ---legacy-background-color: #0B0C10;
    ---legacy-light-background-color: #0F2235;
    ---legacy-highlight-background-color: #2D223D;
    ---legacy-text-color: #E48300;
    ---legacy-highlightable-text: #258FF9;
    ---legacy-highlight-text-color: #A4FFFC;
    ---legacy-extras-color: #268AAA;
    ---legacy-light-tab-border-color: #72569f;
    ---legacy-tab-color: #191b27;
    ---legacy-light-tab-color: #222434;
    ---legacy-high-contrast-text-highlight: #00AAFF;

    
    ---generic-background-color: #1E1E1E;
    ---generic-light-background-color: #252526;
    ---generic-highlight-background-color: #2D2D30;
    ---generic-text-color: #CCCCCC;
    ---generic-highlightable-text: #569CD6;
    ---generic-highlight-text-color: #FFFFFF;
    ---generic-extras-color: #9CDCFE;
    ---generic-light-tab-border-color: #007ACC;
    ---generic-tab-color: #2D2D30;
    ---generic-light-tab-color: #37373D;
    ---old-high-contrast-text-highlight: #FFC83D;
} 


#MainWindow, #MainSupportWidget {
    background-color: transparent;
}

#MainWidget {
    background-color: var(---generic-background-color);
}

QSplitter#Mem-CodeSplitter {
    border-top: 7px solid var(---generic-background-color);
}

QSplitter#Mem-CodeSplitter::handle {
    background-color: var(---generic-background-color);
}


QLabel#Output, QTextEdit#Input {
    color: var(---generic-text-color);
    font-size: 11pt;
    font-family: "Calibri";
    background-color: var(---generic-light-background-color);
    text-align: topleft;
    border: none;
}

QTextEdit#Input {
    qproperty-placeholderText: "Write here your inputs...";
}

QsciScintilla#Editor {
    border: none;
}


QScrollBar:vertical, QScrollBar#VScrollCode:vertical {
    background-color: var(---generic-light-background-color);
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical, QScrollBar#VScrollCode::handle:vertical {
    background-color: var(---generic-extras-color);
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar#VScrollCode::add-page:vertical, QScrollBar#VScrollCode::sub-page:vertical {
    background-color: var(---generic-light-background-color);
    image: none;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, 
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    border: none;
    background: none;
    height: 0;
    width: 0;
}

QScrollBar#TabListScrollBar {
    width: 0;
}


QFrame#EditorWrapper {
    background-color: var(---generic-tab-color);
}

QFrame#EditorFrame > QLabel {
    background-color: var(---generic-highlight-background-color);
    color: var(---generic-highlightable-text);
}

QScrollArea#TabList {
    border: none;
    background-color: var(---generic-tab-color);
}

QFrame#TabListPanel {
    background-color: var(---generic-tab-color);
}


QPushButton#TabButton {
    width: 38px;
    height: 38px;
    background-color: var(---generic-tab-color);
    border: 1px solid var(---generic-tab-color);
}

QPushButton#TabButton:hover {
    border: 1px solid var(---generic-highlightable-text);
}

QPushButton#TabButton::menu-indicator {
    image: none;
}

QMenu#HiddenTabList {
    background-color: var(---generic-background-color);
}

Container, Tab {
    color: var(---generic-extras-color);
    background-color: var(---generic-tab-color);
    padding: 0 5px;
}

Container[marked="true"] {
    background-color: var(---generic-light-tab-color);
    border-left: 2px solid var(---generic-light-tab-border-color);
}

Tab[marked="true"] {
    color: var(---generic-text-color);
    background-color: var(---generic-light-tab-color);
    border-bottom: 2px solid var(---generic-light-tab-border-color);
}

Tab > QToolTip {
    color: var(---generic-light-tab-border-color);
    background-color: var(---generic-light-background-color);
    border: 1px solid var(---generic-highlight-text-color);
    padding: 5px;
    font-size: 14px;

}

QLabel#TabLabel {
    background-color: transparent;
    color: var(---generic-extras-color);
}

QPushButton#Close[tab="true"] {
    height: 12px;
    width: 12px;
    border: 2px solid transparent;
    border-radius: 5px;
    background-color: transparent;
}

QPushButton#Close[tab="true"]:hover {
    background-color: var(---generic-light-tab-border-color);
}

QPushButton#TabIcon {
    background-color: transparent;
    padding-bottom: 2px;
}


QLabel#Options, QLabel#Memory, QLabel#Fragment {
    border: none;
}

QLabel#Options {
    background-color: var(---generic-light-background-color);
}

QLabel#Memory {
    background-color: var(---generic-background-color);
}

QLabel#MemoryLabel {
    background-color: var(---generic-background-color);
    font-size: 15px;
    font-family: "Calibri";
    color: var(---generic-text-color);
}

QScrollArea#GenericScroll {
    background-color: var(---generic-light-background-color);
    border: none;
}

QLabel#KeyLabel {
    color: var(---generic-extras-color);
    background-color: transparent;
    border: none;
}

QLabel#ValueLabel {
    color: var(---generic-text-color);
    background-color: transparent;
    border: none;
}

QLabel#Fragment {
    background-color: var(---generic-background-color);
}

QLabel#Fragment:hover {
    background-color: var(---generic-highlight-background-color);
}

QFrame#RegistersScroll, QFrame#ConstantsScroll, QFrame#VariablesScroll, QFrame#StackScroll, QFrame#Sect_BssScroll, QFrame#Sect_DataScroll {
    background-color: var(---generic-light-background-color);
}


#Toolbar {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                          stop: 0 rgba(15, 42, 79, 255),
                          stop: 0.72 rgba(28, 28, 25, 255));
    border: none;
    border-bottom: 1px solid var(---generic-highlight-background-color);
    font-size: 15px;
    font-family: "Anonymous Pro";
}

QPushButton#Icon {
    background-color: transparent;
    border: none;
}

QPushButton#File, QPushButton#Help, QPushButton#Minimize, QPushButton#Maximize, QPushButton#Close, QPushButton#Run {
    text-align: center;
    qproperty-alignment: AlignCenter;
    color: var(---generic-highlightable-text);
    background-color: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

QPushButton#Minimize, QPushButton#Maximize, QPushButton#Close {
    font-size: 18px;
}

QPushButton#Run {
    font-size: 30px;
}

QLabel#Title {
    background-color: transparent;
    color: var(---generic-highlightable-text);
    border: none;
    margin: 0;
    padding: 0;
    text-align: center;
    qproperty-alignment: AlignCenter;
}


QPushButton#Run:hover {
    color: #4EC9B0;
    background-color: rgba(255, 255, 255, 0.1);
}

QPushButton#File:hover, QPushButton#Help:hover {
    color: var(---generic-highlight-text-color);
    background-color: rgba(255, 255, 255, 0.1);
}

QLabel#Title:hover {
    color: var(---generic-highlight-text-color);
}

QPushButton#Close:hover {
    background-color: #F44747;
}

QPushButton#Minimize:hover, QPushButton#Maximize:hover {
    background-color: #3C3C3C;
}

QPushButton#Minimize:pressed, QPushButton#Maximize:pressed {
    background-color: var(---generic-light-background-color);
}


QPushButton#File::menu-indicator, QPushButton#Help::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

QMenu {
    background-color: var(---generic-light-background-color);
    color: var(---generic-highlightable-text);
}

QMenu::item:hover, QMenu::item:selected {
    color: var(---generic-highlight-text-color);
}


QWidget#Window, QWidget#Trash {
    background-color: var(---generic-background-color);
    border: 1px solid var(---generic-highlight-background-color);
}

QLineEdit#TextBox {
    border: 1px solid var(---generic-background-color);
    border-radius: 10px;
    padding: 0;
    margin: 0 0 0 5px;
    background-color: var(---generic-light-background-color);
    color: var(---generic-highlight-text-color);
    font-size: large;
    font-family: "Fixedsys";
    width: 150px;
}

QPushButton#FileButton {
    background-color: var(---generic-light-background-color);
    color: var(---generic-highlight-text-color);
    border: 1px solid var(---generic-background-color);
    border-radius: 10px;
}

QPushButton#FileButton:hover {
    background-color: var(---generic-highlight-background-color);
    border: 1px solid var(---generic-highlight-text-color);
}

QComboBox#ExtensionBox {
    color: var(---generic-text-color);
    background-color: var(---generic-light-background-color);
    border: 1px solid var(---generic-background-color);
    border-radius: 10px;
    font-size: large;
    font-family: "Fixedsys";
    text-align: center;
    padding-left: 10px;
}

QComboBox#ExtensionBox::drop-down {
    border: none;
}

QComboBox#ExtensionBox::down-arrow {
    image: url(src/graphics/icons/drop-down-arrow.png);
    width: 10px;
    height: 10px;
    margin-right: 10px;
}

QComboBox#ExtensionBox QAbstractItemView {
    background-color: var(---generic-light-background-color);
    color: var(---generic-highlight-text-color);
    selection-background-color: var(---generic-light-tab-border-color);
    selection-color: var(---generic-text-color);
    border: 3px solid var(---generic-light-background-color);
    outline: none;
}

QLabel#Dialog {
    border: 1px solid var(---generic-highlight-text-color);
    background-color: var(---generic-light-tab-color);
}

QLabel#Dialog > QLabel {
    background-color: var(---generic-tab-color);
    color: var(---generic-highlight-text-color);
}

QLabel#Dialog > QLineEdit {
    color: var(---generic-highlight-text-color);
    background-color: var(---generic-highlight-background-color);
    border: none;
    margin: 40% 20%;
    font-family: "Monaco";
    font-size: larger;
    font-weight: 200;
}


QLabel#SettingsSection {
    font-weight: bold;
    margin: 10px 0px;
    color: var(---generic-text-color);
}

QLabel#Tooltip {
    color: #F0E9E9;
    background-color: #404042;
    qproperty-borderColor: #706D6D;
    padding: 5px;
    font-size: 14px;
}

QTabWidget {
    background-color: var(---generic-light-background-color);
    border: none;
}

QTabWidget::pane {
    border: none;
    background-color: var(---generic-light-background-color);
}

QTabBar::tab {
    background-color: var(---generic-tab-color);
    color: var(---generic-extras-color);
    padding: 10px;
    border: 1px solid var(---generic-tab-color);
    width: 100px;
}

QTabBar::tab:selected {
    background-color: var(---generic-light-tab-color);
    color: var(---generic-text-color);
    border: 1px solid var(---generic-light-tab-border-color);
    border-bottom: none;
}

QFrame#TitledLine {
    min-height: 50px;
}

QLabel#TitledLineLabel {
    font-weight: bold;
    font-size: 22px;
    font-family: "sans-serif";
    padding-left: 25px;
    padding-right: 5px;
    color: white;
}
QFrame#TitledLineLine {
    color: white;        /* line color */
    background: white;   /* important for visible line */
    max-height: 1px;   /* thickness */
    margin-right: 50px;
}

QLabel#CPLabel {
    color: var(---generic-text-color);
    background-color: transparent;
    border: none;
    height: 30px;
    width: 200px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 15px;
}

QPushButton#CPColorDialogButton {
    border: 2px solid var(---generic-light-tab-border-color);
    height: 30px;
    width: 30px;
    background-color: var(---generic-extras-color);
}

QPushButton#CPColorDialogButton:hover {
    border: 2px solid var(---old-high-contrast-text-highlight);
}

QLineEdit#CPHexConverter {
    width: 120px;
    height: 30px;
    border: 1px solid var(---generic-light-tab-color);
    border-radius: 5px;
    color: var(---generic-text-color);
    font-size: 20px;
    font-weight: bold;
    font-family: "Monospace";
    background-color: var(---generic-light-background-color);
}

QLineEdit#CPHexConverter:focus {
    border: 1px solid var(---generic-highlight-text-color);
    color: var(---generic-highlight-text-color);
}

QPushButton#ResetButton {
    background-color: var(---generic-highlight-background-color);
    border: 1px solid var(---generic-light-tab-color);
    border-radius: 15px;
    height: 30px;
    width: 30px;
    color: white;
}

QPushButton#ResetButton:hover {
    background-color: darkred;
    color: white;
}